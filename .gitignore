/target
**/*.rs.bk
Cargo.lock.orig

# GUI (M5)
# gui/web はバンドラを使わない手書きのフロントエンド＝ソースなので追跡する。
# dist という名前に置いていたときは、この ignore に掛かって CI が
# 「frontendDist が存在しない」で落ちた。
/gui/node_modules
/gui/src-tauri/target
# gen/ は tauri-build が capabilities/ と tauri.conf.json から毎回作る生成物。
# 追跡するとビルドのたびに差分が出る。クリーンチェックアウトでも
# build.rs が作り直すので、無くてもビルドは通る（確認済み）。
/gui/src-tauri/gen

# 拡張機能 (M4)
/extension/**/node_modules
/extension/**/dist

# ローカルの作業用
*.db
*.db-wal
*.db-shm

.claude